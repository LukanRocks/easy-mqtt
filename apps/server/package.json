    "iron-webcrypto": "^2.0.0",
    "mqtt": "^5.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
