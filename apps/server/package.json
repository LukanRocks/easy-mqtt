{
  "name": "@easy-mqtt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "PORT=3001 tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@easy-mqtt/dynsec": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.0",
    "iron-webcrypto": "^1.2.1",
    "mqtt": "^5.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
