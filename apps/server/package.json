{
  "name": "@easy-mqtt/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "PORT=3001 tsx watch src/server.ts",
